{
  "name": "slidev-studio-desktop",
  "productName": "Slidev Studio",
  "version": "0.2.1-offline.1",
  "description": "Local Slidev project editor",
  "private": true,
  "license": "MIT",
  "author": "Renko",
  "main": "main.cjs",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "start": "node scripts/prepare.cjs && electron-forge start",
    "make": "node scripts/prepare.cjs && electron-forge make --platform=win32 --arch=x64",
    "make:offline": "node scripts/prepare.cjs --offline && electron-forge make --platform=win32 --arch=x64"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "electron": "45.3.2",
    "pnpm": "10.33.0"
  }
}
